<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFrameworks>net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Version>1.2.22</Version>
		<Deterministic>true</Deterministic>
		<NoWarn>$(NoWarn);WFO1000</NoWarn>
		<Configurations>Debug;Release;Source</Configurations>
		<AssemblyName>gamecli</AssemblyName>
		<StartupObject>Program</StartupObject>
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
	</PropertyGroup>
	<PropertyGroup>
		<PackageId>DeepMeta.$(AssemblyName)</PackageId>
	</PropertyGroup>
	<ItemGroup>
		<Compile Include="..\DeepCore.Console\Exec.cs" Link="Exec.cs" />
	</ItemGroup>
	<ItemGroup>
	  <ProjectReference Include="..\DeepCore\DeepCore.csproj" />
	</ItemGroup>


</Project>