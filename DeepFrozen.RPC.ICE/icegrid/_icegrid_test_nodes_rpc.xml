        <NetworkTimeoutMS>30000</NetworkTimeoutMS>
        <DefaultTaskExecuteTimeout>60000</DefaultTaskExecuteTimeout>
        <RpcCodec>TLServer.ServerCodec</RpcCodec>
        <AcceptTypeMappings>
          <!-- 当前服务节点可创建的服务类型 -->
          <GateServer>DeepMMO.Server.Gate.GateServer</GateServer>
          <AreaManager>DeepMMO.Server.AreaManager.AreaManager</AreaManager>
          <ConnectServer>DeepMMO.Server.Connect.ConnectServer</ConnectServer>
          <SessionService>DeepMMO.Server.Connect.SessionService</SessionService>
          <AdminServer>ThreeLives.Service.Admin.AdminServer</AdminServer>
          <PayServer>ThreeLives.Service.Pay.PayServer</PayServer>
