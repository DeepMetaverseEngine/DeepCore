        <!-- 逻辑分组 -->
        <define_call name="ConnDefine" param1="Conn11" param2="127.0.0.1" param3="18011" param4="18011" />
        <define_call name="ConnDefine" param1="Conn12" param2="127.0.0.1" param3="18012" param4="18012" />
