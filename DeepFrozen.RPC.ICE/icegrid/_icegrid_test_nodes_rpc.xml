          <ServiceName>GuildService</ServiceName>
          <ServiceType>GuildService</ServiceType>
          <Config>
            <IndexId>0</IndexId>
            <Quantity>1</Quantity>
          </Config>
        </GuildService>
        <ChatService>
          <ServiceName>ChatService</ServiceName>
          <ServiceType>ChatService</ServiceType>
          <Config></Config>
        </ChatService>
        <ShopService>
          <ServiceName>ShopService</ServiceName>
          <ServiceType>ShopService</ServiceType>
          <Config></Config>
        </ShopService>
	    <!-- -MasterRaceService- -->
        <MasterRaceService>
          <ServiceName>MasterRaceService</ServiceName>
          <ServiceType>MasterRaceService</ServiceType>
          <Config></Config>
        </MasterRaceService>
        <AdminServer>
          <ServiceName>AdminServer</ServiceName>
          <ServiceType>AdminServer</ServiceType>
          <Config>
            <HTTPListen>http://+:18088/</HTTPListen>
            <APIKey>ux4cHMNztECoSKKu</APIKey>
          </Config>
        </AdminServer>
        <PayServer>
          <ServiceName>PayServer</ServiceName>
          <ServiceType>PayServer</ServiceType>
          <Config>
            <HTTPListen>http://+:19088/</HTTPListen>
            <APIKey>ux4cHMNztECoSKKu</APIKey>
          </Config>
        </PayServer>
        <!-- 逻辑分组 -->
        <define_call name="ConnDefine" param1="Conn01" param2="127.0.0.1" param3="18001" param4="18001" />
        <define_call name="ConnDefine" param1="Conn02" param2="127.0.0.1" param3="18002" param4="18002" />
