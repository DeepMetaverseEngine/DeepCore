    <node_02>
      <RpcConfig>
        <LocalNodeName>node_02</LocalNodeName>
        <LocalEndPoint>node_02</LocalEndPoint>
        <NameServerEndPoint>NameServer</NameServerEndPoint>
        <RequestTickTimeMS>5000</RequestTickTimeMS>
        <NetworkTimeoutMS>30000</NetworkTimeoutMS>
        <DefaultTaskExecuteTimeout>60000</DefaultTaskExecuteTimeout>
        <RpcCodec>TLServer.ServerCodec</RpcCodec>
