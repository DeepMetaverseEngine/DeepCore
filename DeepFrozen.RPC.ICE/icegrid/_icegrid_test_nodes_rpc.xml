<?xml version="1.0" encoding="utf-8"?>
<doc>
  <!-- #################################################################################### -->
  <define name="ConnDefine" param1="Name" param2="Host" param3="Port" param4="Listen">
    <ConnectServer>
      <ServiceName>#{Name}</ServiceName>
      <ServiceType>ConnectServer</ServiceType>
      <Config>
        <Name>#{Name}</Name>
        <Host>#{Host}</Host>
        <HostPort>#{Port}</HostPort>
        <Port>#{Listen}</Port>
        <KeepAlive>true</KeepAlive>
        <KeepAliveInterval>30000</KeepAliveInterval>
        <RecvBufferSize>16384</RecvBufferSize>
        <SendBufferSize>16384</SendBufferSize>
        <MaxConnections>3000</MaxConnections>
        <NetCodec>TLClient.Serializer</NetCodec>
      </Config>
    </ConnectServer>
  </define>
  <!-- #################################################################################### -->
  <GlobalConfig>
    <RealmID>22</RealmID>
    <!-- Test -->
    <EnableRpcStatistics>true</EnableRpcStatistics>
    <EnableAllocStatistics>true</EnableAllocStatistics>
    <EnablePoolStatistics>false</EnablePoolStatistics>
    <EnableEventStatistics>true</EnableEventStatistics>
    <EnableLogicStatistics>true</EnableLogicStatistics>
    <EnableMemoryPool>false</EnableMemoryPool>
    <EnableMemoryPoolMax>10240</EnableMemoryPoolMax>
    <EnableLuaLogger>false</EnableLuaLogger>
    <ORM_TEST>false</ORM_TEST>
    <!-- -GameData- -->
    <KickOnError>true</KickOnError>
    <RPGServerBattleManager>TLServer.Common.TLServerBattleManager</RPGServerBattleManager>
    <RPGServerManager>TLServer.Common.TLServerManager</RPGServerManager>
    <RPGServerPersistenceManager>TLServer.Common.TLServerPersistenceManager</RPGServerPersistenceManager>
    <RPGServerTemplateManager>TLServer.Common.TLServerTemplateManager</RPGServerTemplateManager>
    <ZoneDataFactory>TLBattle.Server.TLServerDataFactory</ZoneDataFactory>
    <InstanceZoneFactory>TLBattle.Server.TLServerZoneFactory</InstanceZoneFactory>
    <ZoneServerFactory>TLBattle.Host.TLZoneServerNodeFactory</ZoneServerFactory>
    <GMTUrl>http://office.1gamesh.com:31000</GMTUrl>
    <ServerListUrl>http://office.1gamesh.com:31000/api/server/server_list</ServerListUrl>
    <BattleDataRoot>../data/GameEditors/GameEditor/data/</BattleDataRoot>
    <ServerDataRoot>../data/ServerData/</ServerDataRoot>
    <RedisORMFactory>192.168.1.103,allowAdmin=true,syncTimeout=3000,responseTimeout=3000,connectTimeout=3000</RedisORMFactory>
    <MySQLFactory>server=192.168.1.201;user=tl;database=gmt2;port=3306;password=onegame;SslMode=none;Convert Zero Datetime=True;Allow User Variables=True</MySQLFactory>
    <RedisDababase>5</RedisDababase>
    <RPGServerManager.Config>
      <!-- -Connect同步状态到Gate- -->
      <timer_sec_SyncConnectToGateNotify>5</timer_sec_SyncConnectToGateNotify>  
      <!-- -Gate处理等待队列- -->
      <timer_sec_GateUpdateQueue>10</timer_sec_GateUpdateQueue>
      <!-- -Area同步状态到AreaManager - -->
      <timer_sec_AreaStateNotify>15</timer_sec_AreaStateNotify>
      <!-- -社交刷新定时器- -->
      <timer_sec_OnPollingSocialService>300</timer_sec_OnPollingSocialService>
      <!-- -公会mapping数据清理定时器- -->
      <timer_hour_KeepGuildRoleData>24</timer_hour_KeepGuildRoleData>
      <!-- -角色刷新定时器- -->
      <timer_sec_OnPollingRoleModule>5</timer_sec_OnPollingRoleModule>
      <!-- -玩家断线后，Session保持时间- -->
      <timer_sec_SessionKeepTimeout>30</timer_sec_SessionKeepTimeout>
      <!-- -场景单位公共数据刷新- -->
      <timer_sec_OnPollingAreaZoneNode>15</timer_sec_OnPollingAreaZoneNode>
      <!-- -副本无人后多久清理副本- -->
      <timer_sec_ZoneKeepPlayerTimeout>30</timer_sec_ZoneKeepPlayerTimeout>
      <!-- -场景Close后清理场景时间- -->
      <timer_sec_DelayDestoryTime>30</timer_sec_DelayDestoryTime>
      <!-- -CMD轮询时间- -->
      <timer_sec_OnPollingCMDEvt>10</timer_sec_OnPollingCMDEvt>
      <!-- -定期储存数据10分钟- -->
      <timer_minute_SaveDataTimer>5</timer_minute_SaveDataTimer>
    </RPGServerManager.Config>
  </GlobalConfig>
  <!-- #################################################################################### -->
  <NameServer>
    <!-- # 根节点配置，负责管理所有的ServiceNode，全局唯一节点 -->
    <!-- SNameServerConfig -->
    <RpcConfig>
      <LocalEndPoint>NameServer</LocalEndPoint>
      <NetworkTimeoutMS>15000</NetworkTimeoutMS>
      <RpcCodec>TLServer.ServerCodec</RpcCodec>
    </RpcConfig>
  </NameServer>
  <!-- #################################################################################### -->
  <ServiceNodes>
