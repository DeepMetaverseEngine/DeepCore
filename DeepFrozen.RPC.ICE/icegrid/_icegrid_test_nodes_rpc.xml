          <ChatService>TLServer.Chat.TLChatService</ChatService>
          <ChannelService>TLServer.Chat.TLChannelService</ChannelService>
          <TeamService>TLServer.Team.TLTeamService</TeamService>
          <LogicService>TLServer.Logic.TLLogicService</LogicService>
	  	  <MasterRaceService>TLServer.MasterRace.TLMasterRaceService</MasterRaceService>
        </AcceptTypeMappings>
      </RpcConfig>
      <!-- -启动服务- -->
      <StartService>
        <!-- GateNode，全区，单点 -->
        <GateServer>
          <ServiceName>GateServer</ServiceName>
          <ServiceType>GateServer</ServiceType>
          <Config>
            <Name>GateServer</Name>
            <Port>19001</Port>
            <KeepAlive>true</KeepAlive>
            <KeepAliveInterval>30000</KeepAliveInterval>
            <RecvBufferSize>16384</RecvBufferSize>
            <SendBufferSize>16384</SendBufferSize>
            <MaxConnections>3000</MaxConnections>
            <NetCodec>TLClient.Serializer</NetCodec>
          </Config>
        </GateServer>
        <!-- AreaManager，全区，单点 -->
        <AreaManager>
          <ServiceName>AreaManager</ServiceName>
          <ServiceType>AreaManager</ServiceType>
          <Config></Config>
        </AreaManager>
        <!-- Area负载，全区，可扩展 -->
        <AreaService>
          <ServiceName>Area:1-1</ServiceName>
          <ServiceType>AreaService</ServiceType>
          <Config></Config>
        </AreaService>
        <!-- Ranking负载，全区，可扩展 -->
