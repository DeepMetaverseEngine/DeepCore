<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<configSections>
		<sectionGroup name="userSettings" type="System.Configuration.UserSettingsGroup, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" >
			<section name="DeepGameEditor3D.Main.Properties.EditorSettings" type="System.Configuration.ClientSettingsSection, System, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" allowExeDefinition="MachineToLocalUser" requirePermission="false" />
		</sectionGroup>
	</configSections>
	<appSettings>
		<add key="edit_class"       value="DeepEditor.Plugin3D.GamePlugin3D" />
		<add key="data_class"       value="IOGame.Core.Battle.Data.CardsZoneDataFactory" />
		<add key="zone_host_class"  value="IOGame.Core.Battle.Host.CardsZoneHostFactory" />
		<add key="zone_slave_class" value="IOGame.Core.Battle.Slave.CardsZoneSlaveFactory" />
		<add key="fgui_root" value="" />
	</appSettings>
	<userSettings>
		<DeepGameEditor3D.Main.Properties.EditorSettings>
			<setting name="PropertyDisplayName" serializeAs="String">
				<value />
			</setting>
			<setting name="EventFunctionFont" serializeAs="String">
				<value>Microsoft YaHei UI, 9pt</value>
			</setting>
			<setting name="DarkMode" serializeAs="String">
				<value>False</value>
			</setting>
		</DeepGameEditor3D.Main.Properties.EditorSettings>
	</userSettings>
</configuration>
