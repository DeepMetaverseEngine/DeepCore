<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>1.2.17</Version>
    <Deterministic>true</Deterministic>
    <LangVersion>latest</LangVersion>
    <Configurations>Debug;Release;Source</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>DeepMeta.$(AssemblyName)</PackageId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Channel.World\**" />
    <Compile Remove="Channel\**" />
    <Compile Remove="World\**" />
    <EmbeddedResource Remove="Channel.World\**" />
    <EmbeddedResource Remove="Channel\**" />
    <EmbeddedResource Remove="World\**" />
    <None Remove="Channel.World\**" />
    <None Remove="Channel\**" />
    <None Remove="World\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Remove="Modules\ChannelModule.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeepCore\DeepCore.csproj" />
    <ProjectReference Include="..\Gate.Data\Gate.Data.csproj" />
  </ItemGroup>
</Project>