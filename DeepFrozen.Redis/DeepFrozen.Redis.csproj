<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Version>1.2.19</Version>
    <Deterministic>true</Deterministic>
    <Configurations>Debug;Release;Source</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>DeepMeta.$(AssemblyName)</PackageId>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Source'">
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="ORM\**" />
    <Compile Remove="Persistence\**" />
    <Compile Remove="StackExchange.Redis\**" />
    <EmbeddedResource Remove="ORM\**" />
    <EmbeddedResource Remove="Persistence\**" />
    <EmbeddedResource Remove="StackExchange.Redis\**" />
    <None Remove="ORM\**" />
    <None Remove="Persistence\**" />
    <None Remove="StackExchange.Redis\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ORM\RedisConverter.cs" />
    <Compile Include="ORM\RedisChannel.cs" />
    <Compile Include="ORM\RedisDump.cs" />
    <Compile Include="ORM\RedisORMFactory.cs" />
    <Compile Include="ORM\RedisConditions.cs" />
    <Compile Include="ORM\RedisDatabase.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="MySql.Data" Version="9.6.0" />
    <PackageReference Include="StackExchange.Redis" Version="2.12.8" />
    <PackageReference Include="System.Linq" Version="4.3.0" />
    <PackageReference Include="System.Runtime.InteropServices" Version="4.3.0" />
    <PackageReference Include="System.ValueTuple" Version="4.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\DeepCore\DeepCore.csproj" />
    <ProjectReference Include="..\DeepCrystal\DeepCrystal.csproj" />
    <ProjectReference Include="..\DeepFrozen.Mysql\DeepFrozen.MySQL.csproj" />
  </ItemGroup>
</Project>